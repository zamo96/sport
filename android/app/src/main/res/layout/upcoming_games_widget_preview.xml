<?xml version="1.0" encoding="utf-8"?>
<!--
  Shown in the launcher's widget picker only; the live widget is drawn by Glance.
  It mirrors the empty state of `UpcomingGamesWidget`.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="bottom"
    android:background="@drawable/widget_preview_background"
    android:padding="14dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/upcoming_games_widget_preview_title"
        android:textColor="#FFFFFFFF"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/upcoming_games_widget_preview_time"
        android:textColor="#FF34C759"
        android:textSize="19sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/upcoming_games_widget_preview_venue"
        android:textColor="#B8FFFFFF"
        android:textSize="11sp" />
</LinearLayout>
