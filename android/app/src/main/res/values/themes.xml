<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The whole UI is Compose. This theme only paints the window before the
         first frame, so it uses the same cream page background as AppScreen. -->
    <style name="Theme.SportSearch" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/page_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
