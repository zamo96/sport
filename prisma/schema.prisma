generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Gender {
  male
  female
  other
}

enum Sport {
  table_tennis
  tennis
  padel
  squash
  badminton
  volleyball
  fitness
  boxing
  yoga
  football
  running
  supboard
}

enum PlayFormat {
  singles
  doubles
  both
}

enum Surface {
  hard
  clay
  grass
  any
}

enum CourtSetting {
  indoor
  outdoor
}

enum CourtStatus {
  active
  needs_review
  hidden
  archived
}

enum SwipeAction {
  like
  dislike
  superlike
}

enum MatchStatus {
  active
  archived
}

enum GameRequestStatus {
  pending
  accepted
  declined
  canceled
}

enum GameRequestOutcome {
  played
  not_played
}

enum GameReportStatus {
  pending
  confirmed
  disputed
}

enum GameReportConfirmationStatus {
  pending
  confirmed
  disputed
}

enum GameReportVisibility {
  profile
  participants
  private
}

enum PersonalActivityStatus {
  planned
  completed
  canceled
}

enum GameSearchStatus {
  active
  in_review
  matched
  closed
}

enum GameSearchType {
  regular
  hot
}

enum HotSearchWindow {
  today
  tomorrow
  day_after_tomorrow
}

enum GameSearchResponseStatus {
  pending
  approved
  rejected
  withdrawn
}

enum GameSearchSlotProposalStatus {
  open
  closed
}

enum RegularPairStatus {
  active
  paused
  closed
}

enum RegularPairOccurrenceStatus {
  pending
  confirmed
  declined
  canceled
  expired
}

enum RegularPairOccurrenceConfirmationStatus {
  pending
  confirmed
  declined
}

enum PushPlatform {
  ios
  android
}

enum PushEnvironment {
  development
  production
}

enum AccountStatus {
  active
  deactivated
}

enum LocationSource {
  legacy
  manual
  geolocation
}

/// Согласие на показ анкеты другим людям (ст. 10.1 152-ФЗ).
/// legacy — аккаунт старше раздельных согласий: показывается как раньше, пока
/// человек не ответит на экране согласия. pending — ещё не отвечал, не
/// показывается. visible/hidden — ответ дан.
enum ProfileVisibility {
  legacy
  pending
  visible
  hidden
}

enum ConsentKind {
  profile_visibility
  analytics
}

enum AdminAuditAction {
  PROFILE_UPDATED
  ACCOUNT_DEACTIVATED
  ACCOUNT_REACTIVATED
}

enum AdminCourtAuditAction {
  PROFILE_UPDATED
  STATUS_CHANGED
}

enum ContentReportOrigin {
  report
  block
}

enum ContentReportReason {
  abusive_behavior
  harassment
  hate_speech
  sexual_content
  violence
  spam
  impersonation
  privacy
  illegal_content
  other
}

enum ContentReportType {
  profile
  chat_message
  game_search_message
  game_search
  game_search_response
  game_request
  game_report
  personal_activity
  other
}

enum ContentReportStatus {
  pending
  actioned
  dismissed
}

model District {
  id          String  @id @default(cuid())
  code        String  @unique
  name        String
  city        String
  color       String?
  centerLat   Float?
  centerLng   Float?
  polygon     Json?
  searchHints Json?
  users       User[]  @relation("UserDistrict")
  courts      Court[] @relation("CourtDistrict")

  @@index([city, name])
}

model Metro {
  id         String       @id @default(cuid())
  name       String       @unique
  city       String
  courts     Court[]      @relation("CourtNearestMetro")
  courtLinks CourtMetro[]
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([city, name])
}

model User {
  id                                 String                              @id @default(cuid())
  email                              String                              @unique
  appleSubject                       String?                             @unique
  googleSubject                      String?                             @unique
  name                               String?
  age                                Int?
  gender                             Gender?
  city                               String?
  locationPlaceId                    String?
  locationSource                     LocationSource?
  district                           String?
  preferredDistricts                 Json?
  showOnMap                          Boolean                             @default(true)
  /// По умолчанию legacy, чтобы старые клиенты и уже существующие строки
  /// вели себя как раньше; новый поток регистрации явно ставит pending.
  profileVisibility                  ProfileVisibility                   @default(legacy)
  profileVisibleToGuests             Boolean                             @default(false)
  profileShowsBio                    Boolean                             @default(false)
  profileShowsPhotos                 Boolean                             @default(false)
  profileShowsVideos                 Boolean                             @default(false)
  profileShowsSearches               Boolean                             @default(false)
  analyticsConsent                   Boolean                             @default(false)
  /// ФИО из согласия на показ анкеты (приказ РКН № 18). Не публикуется.
  consentFullName                    String?
  /// Последняя принятая редакция пользовательского соглашения.
  agreementVersion                   String?
  homeLat                            Float?
  homeLng                            Float?
  tennisLevel                        Int?
  preferredSports                    Json?
  sportLevels                        Json?
  preferredPlayFormat                PlayFormat                          @default(both)
  preferredSurface                   Surface                             @default(any)
  bio                                String?
  avatarUrl                          String?
  profilePhotoUrls                   Json?
  profileVideoUrls                   Json?
  /// Порядок фото и видео в карточке — URL из двух списков выше. Чего в нём
  /// нет, клиент дописывает в конец в прежнем порядке «фото, потом видео».
  profileMediaOrder                  Json?
  availableDays                      Json?
  availableTimeRanges                Json?
  availableTimeSlots                 Json?
  availabilityByDay                  Json?
  isLookingForGame                   Boolean                             @default(true)
  isVerified                         Boolean                             @default(false)
  onboardingCompleted                Boolean                             @default(false)
  notificationMatches                Boolean                             @default(true)
  notificationMessages               Boolean                             @default(true)
  notificationGames                  Boolean                             @default(true)
  notificationSound                  Boolean                             @default(true)
  localeOverride                     String?
  timezone                           String?
  notificationDigest                 Boolean                             @default(true)
  accountStatus                      AccountStatus                       @default(active)
  deactivatedAt                      DateTime?
  deactivationReason                 String?
  /// Личный код приглашения, выдаётся по первому запросу.
  inviteCode                         String?                             @unique
  /// Кто привёл этого игрока. Заполняется один раз при регистрации.
  invitedByUserId                    String?
  invitedAt                          DateTime?
  /// Переходы по личной ссылке — знаменатель для конверсии приглашений.
  inviteVisits                       Int                                 @default(0)
  lastInboxSeenAt                    DateTime?
  lastNotificationsSeenAt            DateTime?
  lastActiveAt                       DateTime?
  createdAt                          DateTime                            @default(now())
  updatedAt                          DateTime                            @updatedAt
  districtRef                        District?                           @relation("UserDistrict", fields: [district], references: [code], onDelete: SetNull)
  location                           GeoPlace?                           @relation(fields: [locationPlaceId], references: [id], onDelete: SetNull)
  swipesSent                         Swipe[]                             @relation("SwipeFromUser")
  swipesReceived                     Swipe[]                             @relation("SwipeToUser")
  matchesAsUser1                     Match[]                             @relation("MatchUser1")
  matchesAsUser2                     Match[]                             @relation("MatchUser2")
  sessions                           Session[]
  authCodes                          AuthCode[]
  agreementAcceptances               UserAgreementAcceptance[]
  consents                           UserConsent[]
  sentMessages                      ChatMessage[]
  messageReceipts                    MessageReceipt[]
  uploadedChatMedia                  ChatMediaAsset[]
  gameRequestsCreated                GameRequest[]                       @relation("GameRequestCreator")
  gameRequestsReceived               GameRequest[]                       @relation("GameRequestRecipient")
  gameSearches                       GameSearch[]
  gameSearchMessages                 GameSearchMessage[]
  gameSearchResponses                GameSearchResponse[]
  gameSearchSlotVotes                GameSearchSlotVote[]
  regularPairsCreated                RegularPair[]                       @relation("RegularPairCreator")
  regularPairsPartner                RegularPair[]                       @relation("RegularPairPartner")
  regularPairOccurrenceConfirmations RegularPairOccurrenceConfirmation[]
  gameReportsCreated                 GameReport[]                        @relation("GameReportCreator")
  gameReportConfirmations            GameReportConfirmation[]
  personalActivities                 PersonalActivity[]
  pushDevices                        PushDevice[]
  courtMemberships                   UserCourt[]
  blockedUsers                       Block[]                             @relation("BlockerUser")
  blockingUsers                      Block[]                             @relation("BlockedUser")
  events                             UserEvent[]
  notificationDeliveries             NotificationDelivery[]
  contentReportsMade                 ContentReport[]                     @relation("ContentReportReporter")
  contentReportsReceived             ContentReport[]                     @relation("ContentReportTarget")
  contentReportsReviewed             ContentReport[]                     @relation("ContentReportReviewer")
  invitedBy                          User?                               @relation("UserInvites", fields: [invitedByUserId], references: [id], onDelete: SetNull)
  invitedUsers                       User[]                              @relation("UserInvites")

  @@index([invitedByUserId])
  @@index([accountStatus, createdAt])
  @@index([locationPlaceId, accountStatus])
}

model GeoPlace {
  id              String       @id
  provider        String
  providerPlaceId String
  countryCode     String
  countryName     String
  region          String?
  city            String
  normalizedCity  String
  latitude        Float
  longitude       Float
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  users           User[]
  gameSearches    GameSearch[]
  serviceArea     ServiceArea?

  @@unique([provider, providerPlaceId])
  @@index([countryCode, normalizedCity])
}

model ServiceArea {
  id               String   @id @default(cuid())
  locationPlaceId  String   @unique
  legacyCity       String?  @unique
  isActive         Boolean  @default(true)
  clubsEnabled     Boolean  @default(false)
  districtsEnabled Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  location         GeoPlace @relation(fields: [locationPlaceId], references: [id], onDelete: Cascade)
}

model AdminAuditLog {
  id           String           @id @default(cuid())
  actorUserId  String
  actorEmail   String
  targetUserId String
  targetEmail  String
  action       AdminAuditAction
  reason       String?
  before       Json?
  after        Json?
  createdAt    DateTime         @default(now())

  @@index([targetUserId, createdAt])
  @@index([actorUserId, createdAt])
}

model DiscoverImpression {
  id              String   @id @default(cuid())
  viewerUserId    String
  candidateUserId String
  source          String   @default("discover")
  rank            Int
  baseScore       Float?
  finalScore      Float?
  createdAt       DateTime @default(now())

  @@index([viewerUserId, createdAt])
  @@index([candidateUserId, createdAt])
  @@index([viewerUserId, candidateUserId, createdAt])
  @@index([source, createdAt])
}

model UserEvent {
  id         String   @id @default(cuid())
  userId     String
  type       String
  entityType String?
  entityId   String?
  context    Json?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, createdAt])
  @@index([type, createdAt])
  @@index([createdAt])
}

model NotificationDelivery {
  id          String    @id @default(cuid())
  userId      String
  campaignKey String
  dedupeKey   String    @unique
  variant     String    @default("treatment")
  title       String
  body        String
  href        String
  context     Json?
  sentAt      DateTime?
  openedAt    DateTime?
  convertedAt DateTime?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, campaignKey, createdAt])
  @@index([campaignKey, createdAt])
  @@index([userId, createdAt])
}

model Court {
  id                     String                  @id @default(cuid())
  name                   String
  address                String
  city                   String
  district               String?
  nearestMetroId         String?
  locationLat            Float
  locationLng            Float
  surface                Surface
  setting                CourtSetting
  status                 CourtStatus             @default(active)
  supportedSports        Json?
  phone                  String?
  workingHours           String?
  yandexMapsUrl          String?
  websiteUrl             String?
  about                  String?
  amenities              Json?
  messengerType          String?
  messengerUrl           String?
  photoUrl               String?
  photoUrls              Json?
  priceRange             String
  rating                 Float?
  sourceType             String
  sourceExternalId       String?
  sourceUrl              String?
  normalizedName         String?
  normalizedAddress      String?
  syncHash               String?
  lastCheckedAt          DateTime?
  lastSeenAt             DateTime?
  websiteContentHash     String?
  websiteLastCheckedAt   DateTime?
  websiteLastChangedAt   DateTime?
  bookingUrl             String?
  manualOverrideFields   Json?
  manualStatusOverride   Boolean                 @default(false)
  moderatedAt            DateTime?
  moderatedByEmail       String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  districtRef            District?               @relation("CourtDistrict", fields: [district], references: [code], onDelete: SetNull)
  nearestMetro           Metro?                  @relation("CourtNearestMetro", fields: [nearestMetroId], references: [id], onDelete: SetNull)
  gameRequests           GameRequest[]
  gameSearches           GameSearch[]
  scheduledGameSearches  GameSearch[]            @relation("GameSearchScheduledCourt")
  gameSearchSlotOptions  GameSearchSlotOption[]
  regularPairs           RegularPair[]
  regularPairOccurrences RegularPairOccurrence[]
  personalActivities     PersonalActivity[]
  members                UserCourt[]
  metroLinks             CourtMetro[]
  syncChanges            CourtChangeProposal[]
  websiteChecks          CourtWebsiteCheck[]

  @@index([district])
  @@index([nearestMetroId])
  @@index([status, city])
  @@index([sourceType, sourceExternalId])
  @@index([normalizedName, normalizedAddress, city])
}

model AdminCourtAuditLog {
  id          String                @id @default(cuid())
  actorUserId String
  actorEmail  String
  courtId     String
  courtName   String
  action      AdminCourtAuditAction
  reason      String?
  before      Json?
  after       Json?
  createdAt   DateTime              @default(now())

  @@index([courtId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
}

model CourtSyncRun {
  id                  String                @id @default(cuid())
  sourceType          String
  city                String
  status              String                @default("running")
  startedAt           DateTime              @default(now())
  finishedAt          DateTime?
  fetchedCount        Int                   @default(0)
  createdCount        Int                   @default(0)
  updatedCount        Int                   @default(0)
  unchangedCount      Int                   @default(0)
  proposedCount       Int                   @default(0)
  hiddenCount         Int                   @default(0)
  websiteCheckedCount Int                   @default(0)
  websiteChangedCount Int                   @default(0)
  websiteFailedCount  Int                   @default(0)
  errorMessage        String?
  metadata            Json?
  changes             CourtChangeProposal[]
  websiteChecks       CourtWebsiteCheck[]

  @@index([sourceType, startedAt])
  @@index([city, startedAt])
  @@index([status, startedAt])
}

model CourtChangeProposal {
  id               String        @id @default(cuid())
  runId            String?
  courtId          String?
  sourceType       String
  sourceExternalId String?
  action           String
  status           String        @default("pending")
  confidence       Float         @default(0)
  reason           String
  before           Json?
  after            Json
  createdAt        DateTime      @default(now())
  appliedAt        DateTime?
  run              CourtSyncRun? @relation(fields: [runId], references: [id], onDelete: SetNull)
  court            Court?        @relation(fields: [courtId], references: [id], onDelete: SetNull)

  @@index([runId, status])
  @@index([courtId, status])
  @@index([sourceType, sourceExternalId])
  @@index([status, createdAt])
}

model CourtWebsiteCheck {
  id                     String        @id @default(cuid())
  runId                  String?
  courtId                String
  url                    String
  status                 String
  checkedAt              DateTime      @default(now())
  httpStatus             Int?
  contentHash            String?
  title                  String?
  description            String?
  detectedPhones         Json?
  detectedBookingUrls    Json?
  closureSignals         Json?
  analystProvider        String?
  analystModel           String?
  analystStatus          String?
  analystErrorMessage    String?
  screenshotStatus       String?
  screenshotErrorMessage String?
  changed                Boolean       @default(false)
  errorMessage           String?
  run                    CourtSyncRun? @relation(fields: [runId], references: [id], onDelete: SetNull)
  court                  Court         @relation(fields: [courtId], references: [id], onDelete: Cascade)

  @@index([runId, status])
  @@index([courtId, checkedAt])
  @@index([status, checkedAt])
}

model CourtMetro {
  id        String   @id @default(cuid())
  courtId   String
  metroId   String
  position  Int      @default(0)
  createdAt DateTime @default(now())
  court     Court    @relation(fields: [courtId], references: [id], onDelete: Cascade)
  metro     Metro    @relation(fields: [metroId], references: [id], onDelete: Cascade)

  @@unique([courtId, metroId])
  @@index([courtId, position])
  @@index([metroId])
}

model UserCourt {
  id        String   @id @default(cuid())
  userId    String
  courtId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  court     Court    @relation(fields: [courtId], references: [id], onDelete: Cascade)

  @@unique([userId, courtId])
  @@index([courtId, updatedAt])
  @@index([userId, updatedAt])
}

model Swipe {
  id         String      @id @default(cuid())
  fromUserId String
  toUserId   String
  action     SwipeAction
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  fromUser   User        @relation("SwipeFromUser", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser     User        @relation("SwipeToUser", fields: [toUserId], references: [id], onDelete: Cascade)

  @@unique([fromUserId, toUserId])
  @@index([toUserId, action])
}

model Match {
  id           String        @id @default(cuid())
  user1Id      String
  user2Id      String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  status       MatchStatus   @default(active)
  user1        User          @relation("MatchUser1", fields: [user1Id], references: [id], onDelete: Cascade)
  user2        User          @relation("MatchUser2", fields: [user2Id], references: [id], onDelete: Cascade)
  messages     ChatMessage[]
  gameRequests GameRequest[]
  regularPairs RegularPair[]

  @@unique([user1Id, user2Id])
  @@index([user1Id, updatedAt])
  @@index([user2Id, updatedAt])
}

model GameRequest {
  id                      String                 @id @default(cuid())
  matchId                 String
  sharedRootId            String?
  regularPairOccurrenceId String?                @unique
  createdByUserId         String
  matchedUserId           String
  proposedCourtId         String?
  proposedDatetime        DateTime
  durationMinutes         Int?
  levelRangeMin           Int?
  levelRangeMax           Int?
  sport                   Sport                  @default(tennis)
  format                  PlayFormat
  runningRoute            String?
  runningRoutePoints      Json?
  comment                 String?
  status                  GameRequestStatus      @default(pending)
  outcome                 GameRequestOutcome?
  outcomeUpdatedAt        DateTime?
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  match                   Match                  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  sharedRoot              GameRequest?           @relation("GameRequestShareRoot", fields: [sharedRootId], references: [id], onDelete: SetNull)
  sharedInvites           GameRequest[]          @relation("GameRequestShareRoot")
  regularPairOccurrence   RegularPairOccurrence? @relation(fields: [regularPairOccurrenceId], references: [id], onDelete: SetNull)
  createdByUser           User                   @relation("GameRequestCreator", fields: [createdByUserId], references: [id], onDelete: Cascade)
  matchedUser             User                   @relation("GameRequestRecipient", fields: [matchedUserId], references: [id], onDelete: Cascade)
  proposedCourt           Court?                 @relation(fields: [proposedCourtId], references: [id], onDelete: SetNull)
  messages                ChatMessage[]
  report                  GameReport?

  @@index([matchedUserId, status])
  @@index([createdByUserId, status])
  @@index([sharedRootId, status])
}

model ChatMessage {
  id            String             @id @default(cuid())
  matchId       String
  gameRequestId String?
  senderUserId  String
  text          String
  createdAt     DateTime           @default(now())
  match         Match              @relation(fields: [matchId], references: [id], onDelete: Cascade)
  gameRequest   GameRequest?       @relation(fields: [gameRequestId], references: [id], onDelete: Cascade)
  senderUser    User               @relation(fields: [senderUserId], references: [id], onDelete: Cascade)
  attachments   ChatMessageMedia[]
  receipts      MessageReceipt[]

  @@index([matchId, createdAt])
  @@index([gameRequestId, createdAt])
}

model ChatMediaAsset {
  id                 String                  @id @default(cuid())
  uploaderUserId     String
  storageKey         String                  @unique
  mimeType           String
  byteSize           Int
  originalName       String?
  claimedAt          DateTime?
  createdAt          DateTime                @default(now())
  uploaderUser       User                    @relation(fields: [uploaderUserId], references: [id], onDelete: Cascade)
  chatMessageMedia   ChatMessageMedia?
  searchMessageMedia GameSearchMessageMedia?

  @@index([uploaderUserId, claimedAt, createdAt])
}

model ChatMessageMedia {
  chatMessageId String
  assetId       String         @unique
  position      Int
  chatMessage   ChatMessage    @relation(fields: [chatMessageId], references: [id], onDelete: Cascade)
  asset         ChatMediaAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@id([chatMessageId, assetId])
  @@unique([chatMessageId, position])
}

model GameReport {
  id              String                   @id @default(cuid())
  gameRequestId   String                   @unique
  createdByUserId String
  comment         String?
  visibility      GameReportVisibility     @default(profile)
  status          GameReportStatus         @default(pending)
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  gameRequest     GameRequest              @relation(fields: [gameRequestId], references: [id], onDelete: Cascade)
  createdByUser   User                     @relation("GameReportCreator", fields: [createdByUserId], references: [id], onDelete: Cascade)
  photos          GameReportPhoto[]
  confirmations   GameReportConfirmation[]

  @@index([createdByUserId, createdAt])
  @@index([status, createdAt])
}

model GameReportPhoto {
  id        String     @id @default(cuid())
  reportId  String
  url       String
  position  Int        @default(0)
  createdAt DateTime   @default(now())
  report    GameReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId, position])
}

model GameReportConfirmation {
  id        String                       @id @default(cuid())
  reportId  String
  userId    String
  status    GameReportConfirmationStatus @default(pending)
  createdAt DateTime                     @default(now())
  updatedAt DateTime                     @updatedAt
  report    GameReport                   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  user      User                         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reportId, userId])
  @@index([userId, status])
}

model PersonalActivity {
  id              String                  @id @default(cuid())
  userId          String
  courtId         String
  sport           Sport                   @default(tennis)
  scheduledAt     DateTime
  durationMinutes Int?
  comment         String?
  status          PersonalActivityStatus  @default(planned)
  reportComment   String?
  videoUrls       Json                    @default("[]")
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  user            User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  court           Court                   @relation(fields: [courtId], references: [id], onDelete: Restrict)
  photos          PersonalActivityPhoto[]

  @@index([userId, scheduledAt])
  @@index([courtId, scheduledAt])
  @@index([status, scheduledAt])
}

model PersonalActivityPhoto {
  id         String           @id @default(cuid())
  activityId String
  url        String
  position   Int              @default(0)
  createdAt  DateTime         @default(now())
  activity   PersonalActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@index([activityId, position])
}

model GameSearch {
  id                       String                   @id @default(cuid())
  inviteSlug               String?                  @unique
  createdByUserId          String
  locationPlaceId          String?
  locationCountryCode      String?
  locationCity             String?
  preferredCourtId         String?
  customVenueTitle         String?
  customVenueAddress       String?
  runningRoute             String?
  runningRoutePoints       Json?
  preferredDistricts       Json?
  scheduledCourtId         String?
  preferredDays            Json
  preferredTimeRanges      Json
  searchType               GameSearchType           @default(regular)
  hotWindow                HotSearchWindow?
  hotStartsAt              DateTime?
  durationMinutes          Int?
  scheduledAt              DateTime?
  scheduledDurationMinutes Int?
  hasCourtBooked           Boolean                  @default(false)
  sport                    Sport                    @default(tennis)
  selfLevel                Int?
  selfLevelUnknown         Boolean                  @default(false)
  desiredLevelMin          Int                      @default(1)
  desiredLevelMax          Int                      @default(10)
  format                   PlayFormat
  playersNeeded            Int                      @default(1)
  comment                  String?
  status                   GameSearchStatus         @default(active)
  isActive                 Boolean                  @default(true)
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt
  createdByUser            User                     @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)
  location                 GeoPlace?                @relation(fields: [locationPlaceId], references: [id], onDelete: SetNull)
  preferredCourt           Court?                   @relation(fields: [preferredCourtId], references: [id], onDelete: SetNull)
  scheduledCourt           Court?                   @relation("GameSearchScheduledCourt", fields: [scheduledCourtId], references: [id], onDelete: SetNull)
  responses                GameSearchResponse[]
  regularPair              RegularPair?
  messages                 GameSearchMessage[]
  slotProposals            GameSearchSlotProposal[]

  @@index([createdByUserId, isActive])
  @@index([isActive, searchType, status])
  @@index([locationPlaceId, isActive, searchType, status])
}

model GameSearchResponse {
  id              String                   @id @default(cuid())
  gameSearchId    String
  responderUserId String
  message         String?
  status          GameSearchResponseStatus @default(pending)
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  gameSearch      GameSearch               @relation(fields: [gameSearchId], references: [id], onDelete: Cascade)
  responderUser   User                     @relation(fields: [responderUserId], references: [id], onDelete: Cascade)

  @@unique([gameSearchId, responderUserId])
  @@index([gameSearchId, status])
  @@index([responderUserId, status])
}

model GameSearchMessage {
  id           String                   @id @default(cuid())
  gameSearchId String
  senderUserId String
  text         String
  createdAt    DateTime                 @default(now())
  gameSearch   GameSearch               @relation(fields: [gameSearchId], references: [id], onDelete: Cascade)
  senderUser   User                     @relation(fields: [senderUserId], references: [id], onDelete: Cascade)
  attachments  GameSearchMessageMedia[]
  receipts     MessageReceipt[]

  @@index([gameSearchId, createdAt])
}

model MessageReceipt {
  id                  String             @id @default(cuid())
  userId              String
  chatMessageId       String?
  gameSearchMessageId String?
  deliveredAt         DateTime           @default(now())
  readAt              DateTime?
  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  chatMessage         ChatMessage?       @relation(fields: [chatMessageId], references: [id], onDelete: Cascade)
  gameSearchMessage   GameSearchMessage? @relation(fields: [gameSearchMessageId], references: [id], onDelete: Cascade)

  @@unique([chatMessageId, userId])
  @@unique([gameSearchMessageId, userId])
  @@index([userId])
}

model GameSearchMessageMedia {
  gameSearchMessageId String
  assetId             String            @unique
  position            Int
  gameSearchMessage   GameSearchMessage @relation(fields: [gameSearchMessageId], references: [id], onDelete: Cascade)
  asset               ChatMediaAsset    @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@id([gameSearchMessageId, assetId])
  @@unique([gameSearchMessageId, position])
}

model GameSearchSlotProposal {
  id           String                       @id @default(cuid())
  gameSearchId String
  comment      String?
  status       GameSearchSlotProposalStatus @default(open)
  createdAt    DateTime                     @default(now())
  updatedAt    DateTime                     @updatedAt
  gameSearch   GameSearch                   @relation(fields: [gameSearchId], references: [id], onDelete: Cascade)
  options      GameSearchSlotOption[]

  @@index([gameSearchId, status, createdAt])
}

model GameSearchSlotOption {
  id              String                 @id @default(cuid())
  proposalId      String
  proposedCourtId String?
  scheduledAt     DateTime
  durationMinutes Int?
  createdAt       DateTime               @default(now())
  proposal        GameSearchSlotProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  proposedCourt   Court?                 @relation(fields: [proposedCourtId], references: [id], onDelete: SetNull)
  votes           GameSearchSlotVote[]

  @@index([proposalId, scheduledAt])
}

model GameSearchSlotVote {
  id        String               @id @default(cuid())
  optionId  String
  userId    String
  createdAt DateTime             @default(now())
  option    GameSearchSlotOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([optionId, userId])
  @@index([userId, createdAt])
}

model RegularPair {
  id                  String                  @id @default(cuid())
  gameSearchId        String                  @unique
  matchId             String
  createdByUserId     String
  partnerUserId       String
  preferredCourtId    String?
  sport               Sport                   @default(tennis)
  format              PlayFormat
  preferredDays       Json
  preferredTimeRanges Json
  comment             String?
  status              RegularPairStatus       @default(active)
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  gameSearch          GameSearch              @relation(fields: [gameSearchId], references: [id], onDelete: Cascade)
  match               Match                   @relation(fields: [matchId], references: [id], onDelete: Cascade)
  createdByUser       User                    @relation("RegularPairCreator", fields: [createdByUserId], references: [id], onDelete: Cascade)
  partnerUser         User                    @relation("RegularPairPartner", fields: [partnerUserId], references: [id], onDelete: Cascade)
  preferredCourt      Court?                  @relation(fields: [preferredCourtId], references: [id], onDelete: SetNull)
  occurrences         RegularPairOccurrence[]

  @@index([createdByUserId, status])
  @@index([partnerUserId, status])
  @@index([matchId])
}

model RegularPairOccurrence {
  id              String                              @id @default(cuid())
  regularPairId   String
  scheduledAt     DateTime
  scheduleAnchor  DateTime?
  durationMinutes Int?
  proposedCourtId String?
  sport           Sport                               @default(tennis)
  format          PlayFormat
  status          RegularPairOccurrenceStatus         @default(pending)
  createdAt       DateTime                            @default(now())
  updatedAt       DateTime                            @updatedAt
  regularPair     RegularPair                         @relation(fields: [regularPairId], references: [id], onDelete: Cascade)
  proposedCourt   Court?                              @relation(fields: [proposedCourtId], references: [id], onDelete: SetNull)
  confirmations   RegularPairOccurrenceConfirmation[]
  gameRequest     GameRequest?

  @@unique([regularPairId, scheduledAt])
  @@index([regularPairId, status, scheduledAt])
}

model RegularPairOccurrenceConfirmation {
  id           String                                  @id @default(cuid())
  occurrenceId String
  userId       String
  status       RegularPairOccurrenceConfirmationStatus @default(pending)
  respondedAt  DateTime?
  createdAt    DateTime                                @default(now())
  updatedAt    DateTime                                @updatedAt
  occurrence   RegularPairOccurrence                   @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)
  user         User                                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([occurrenceId, userId])
  @@index([userId, status])
}

model Block {
  id            String         @id @default(cuid())
  blockerUserId String
  blockedUserId String
  createdAt     DateTime       @default(now())
  blockerUser   User           @relation("BlockerUser", fields: [blockerUserId], references: [id], onDelete: Cascade)
  blockedUser   User           @relation("BlockedUser", fields: [blockedUserId], references: [id], onDelete: Cascade)
  contentReport ContentReport?

  @@unique([blockerUserId, blockedUserId])
  @@index([blockedUserId])
}

model ContentReport {
  id               String              @id @default(cuid())
  reporterUserId   String?
  reporterEmail    String
  reporterName     String?
  reportedUserId   String?
  reportedEmail    String
  reportedName     String?
  blockId          String?             @unique
  origin           ContentReportOrigin
  reason           ContentReportReason
  details          String?
  contentType      ContentReportType   @default(profile)
  contextId        String?
  contextSnapshot  Json?
  status           ContentReportStatus @default(pending)
  dueAt            DateTime
  reviewedByUserId String?
  reviewedByEmail  String?
  reviewedAt       DateTime?
  resolutionNote   String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  reporterUser     User?               @relation("ContentReportReporter", fields: [reporterUserId], references: [id], onDelete: SetNull)
  reportedUser     User?               @relation("ContentReportTarget", fields: [reportedUserId], references: [id], onDelete: SetNull)
  reviewedByUser   User?               @relation("ContentReportReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  block            Block?              @relation(fields: [blockId], references: [id], onDelete: SetNull)

  @@index([status, dueAt])
  @@index([reportedUserId, createdAt])
  @@index([reporterUserId, createdAt])
  @@index([origin, createdAt])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model AuthCode {
  id         String    @id @default(cuid())
  email      String
  code       String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  userId     String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email, createdAt])
}

model UserAgreementAcceptance {
  id                         String   @id @default(cuid())
  userId                     String
  agreementKey               String
  agreementVersion           String
  personalDataConsentVersion String?
  acceptedVia                String
  acceptedAt                 DateTime @default(now())
  ipAddress                  String?
  userAgent                  String?
  user                       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, agreementKey, agreementVersion])
  @@index([userId, agreementKey, acceptedAt])
}

/// Журнал ответов на отдельные согласия: каждая выдача, изменение и отзыв —
/// новая строка. Текущее состояние лежит в полях User.
model UserConsent {
  id          String      @id @default(cuid())
  userId      String
  kind        ConsentKind
  version     String
  granted     Boolean
  /// Выбор на момент ответа: что показывать и кому.
  scope       Json?
  fullName    String?
  source      String
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime    @default(now())
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind, createdAt])
}

model PushDevice {
  id                String          @id @default(cuid())
  userId            String
  platform          PushPlatform    @default(ios)
  environment       PushEnvironment @default(development)
  token             String          @unique
  bundleId          String
  deviceName        String?
  /// Язык интерфейса приложения на момент регистрации — сигнал для языка пушей.
  locale            String?
  isActive          Boolean         @default(true)
  lastRegisteredAt  DateTime        @default(now())
  lastDeliveredAt   DateTime?
  lastFailureAt     DateTime?
  lastFailureReason String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, platform, isActive])
  @@index([environment, isActive])
}

// Durable markers for bounded deployment SQL; retain across Prisma db push.
model DeploymentMigration {
  id        String   @id
  appliedAt DateTime @default(now())
}
